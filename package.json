{
  "name": "openai-handshakegame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:kit": "bash tools/blender/kit/build-kit.sh",
    "dev": "node tools/dev.mjs",
    "dev:client": "vite",
    "server": "node --experimental-strip-types server/index.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify": "node tools/verify-all.mjs",
    "verify:seeds": "node tools/verify-seeds.mjs",
    "qa": "node tools/qa/run.mjs",
    "playtest:all": "node tools/playtest/all.mjs",
    "qa:servers": "PORT=2583 node --experimental-strip-types server/index.mjs & VITE_COLYSEUS_URL=ws://127.0.0.1:2583 npx vite --port 5183 --strictPort --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.29.0",
    "@colyseus/sdk": "^0.18.5",
    "colyseus": "^0.18.9",
    "uqr": "^0.1.3"
  }
}
